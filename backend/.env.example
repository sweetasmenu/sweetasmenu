# Smart Menu Backend Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===========================================
# STRIPE CONFIGURATION (for customer order card payments only)
# ===========================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===========================================
# BLINKPAY CONFIGURATION (for SaaS subscription billing)
# ===========================================
# Get these from https://developers.blinkpay.co.nz
BLINKPAY_CLIENT_ID=your_blinkpay_client_id
BLINKPAY_CLIENT_SECRET=your_blinkpay_client_secret
BLINKPAY_API_URL=https://sandbox.debit.blinkpay.co.nz

# ===========================================
# FRONTEND URL (for payment redirects)
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# AI SERVICES (Optional)
# ===========================================
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=8000
HOST=0.0.0.0
